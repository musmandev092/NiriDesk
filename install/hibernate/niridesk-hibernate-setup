#!/bin/bash
# Suspend-then-hibernate to a swapfile inside the encrypted root; safe to re-run.
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
SWAPDIR=/swap
SWAPFILE=$SWAPDIR/swapfile
SWAPPRI=10
DELAY=${HIBERNATE_DELAY:-2h}
LIBEXEC=/usr/local/libexec

[ "$(id -u)" = 0 ] || { echo "run as root" >&2; exit 1; }
say() { echo "hibernate-setup: $*"; }

ram_kib=$(sed -n 's/^MemTotal: *\([0-9]*\) kB/\1/p' /proc/meminfo)
size_gib=$(( (ram_kib + 1048575) / 1048576 + 1 ))
fstype=$(findmnt -no FSTYPE /)
uuid=$(findmnt -no UUID /)
src=$(findmnt -no SOURCE / | sed 's/\[.*//')
say "root $fstype UUID=$uuid on $src, RAM $((ram_kib / 1024)) MiB, swapfile ${size_gib} GiB"

image_pending() { [ -f "$SWAPFILE" ] && blkid -p -o value -s TYPE "$SWAPFILE" 2>/dev/null | grep -q swsuspend; }
if image_pending; then say "$SWAPFILE holds a hibernation image; resume it first. Nothing changed."; exit 1; fi

# 1. swap location
if [ "$fstype" = btrfs ]; then
    if ! btrfs subvolume show "$SWAPDIR" >/dev/null 2>&1; then
        tmp=$(mktemp -d)
        mount -o subvolid=5 "$src" "$tmp"
        [ -d "$tmp/swap" ] || btrfs subvolume create "$tmp/swap"
        umount "$tmp"; rmdir "$tmp"
        mkdir -p "$SWAPDIR"
        grep -qE "^[^#]+[[:space:]]$SWAPDIR[[:space:]]" /etc/fstab || \
            echo "UUID=$uuid $SWAPDIR btrfs subvol=swap,x-systemd.device-timeout=0 0 0" >> /etc/fstab
        systemctl daemon-reload
        mount "$SWAPDIR"
    fi
else
    mkdir -p "$SWAPDIR"
fi
chmod 700 "$SWAPDIR"

# 2. swapfile (create only when missing or the wrong size)
want_bytes=$((size_gib * 1073741824))
if [ -f "$SWAPFILE" ] && [ "$(stat -c %s "$SWAPFILE")" -ge "$want_bytes" ]; then
    say "keeping existing $SWAPFILE"
else
    if grep -q "^$SWAPFILE " /proc/swaps; then swapoff "$SWAPFILE"; fi
    rm -f "$SWAPFILE"
    case $fstype in
        btrfs) btrfs filesystem mkswapfile --size "${size_gib}g" --uuid clear "$SWAPFILE" ;;
        ext4) fallocate -l "${size_gib}G" "$SWAPFILE"; chmod 600 "$SWAPFILE"; mkswap "$SWAPFILE" ;;
        xfs) dd if=/dev/zero of="$SWAPFILE" bs=1M count=$((size_gib * 1024)) status=none; chmod 600 "$SWAPFILE"; mkswap "$SWAPFILE" ;;
        *) say "unsupported root filesystem $fstype"; exit 1 ;;
    esac
fi
chmod 600 "$SWAPFILE"
[ "$fstype" = btrfs ] && { lsattr "$SWAPFILE" | grep -q C || { say "swapfile is not NOCOW"; exit 1; }; }

# 3. SELinux: a persistent rule, so relabels keep swapfile_t (a new subvolume root starts unlabeled_t)
if command -v selinuxenabled >/dev/null && selinuxenabled; then
    if command -v semanage >/dev/null; then
        semanage fcontext -l -C | grep -qF "$SWAPDIR(/.*)?" || semanage fcontext -a -t swapfile_t "$SWAPDIR(/.*)?"
        restorecon -RF "$SWAPDIR"
    else
        say "semanage missing (policycoreutils-python-utils); label is not persistent"
        chcon -R -t swapfile_t "$SWAPDIR"
    fi
    ls -dZ "$SWAPDIR" "$SWAPFILE"
fi

# 4. fstab + zram priority
grep -q "^$SWAPFILE " /etc/fstab || echo "$SWAPFILE none swap defaults,pri=$SWAPPRI,nofail 0 0" >> /etc/fstab
cat > /etc/systemd/zram-generator.conf <<'EOF'
[zram0]
zram-size = min(ram, 8192)
compression-algorithm = zstd
swap-priority = 100
EOF
systemctl daemon-reload
grep -q "^$SWAPFILE " /proc/swaps || swapon -p "$SWAPPRI" "$SWAPFILE"

# 5. initramfs resume support for every kernel
echo 'add_dracutmodules+=" resume "' > /etc/dracut.conf.d/90-niridesk-resume.conf

# 6. sleep and lid policy
mkdir -p /etc/systemd/sleep.conf.d /etc/systemd/logind.conf.d
cat > /etc/systemd/sleep.conf.d/90-niridesk.conf <<EOF
[Sleep]
AllowHibernation=yes
AllowSuspendThenHibernate=yes
HibernateDelaySec=$DELAY
SuspendEstimationSec=1h
HibernateOnACPower=yes
EOF
cat > /etc/systemd/logind.conf.d/90-niridesk-lid.conf <<'EOF'
[Login]
HandleLidSwitch=suspend-then-hibernate
HandleLidSwitchExternalPower=suspend
HandleLidSwitchDocked=ignore
EOF

# 7. resume args checker (boot + before hibernate)
install -Dm755 "$HERE/niridesk-resume-check" "$LIBEXEC/niridesk-resume-check"
install -Dm644 "$HERE/niridesk-resume-check.service" /etc/systemd/system/niridesk-resume-check.service
install -Dm644 "$HERE/niridesk-resume-check-sleep.service" /etc/systemd/system/niridesk-resume-check-sleep.service
install -Dm644 "$HERE/niridesk-resume-check.timer" /etc/systemd/system/niridesk-resume-check.timer
restorecon -R "$LIBEXEC" /etc/systemd/system/niridesk-resume-check* 2>/dev/null || true
systemctl daemon-reload
systemctl enable niridesk-resume-check.service niridesk-resume-check-sleep.service niridesk-resume-check.timer
say "regenerating initramfs for all kernels"
dracut --regenerate-all --force
"$LIBEXEC/niridesk-resume-check" setup
systemctl kill -s HUP systemd-logind 2>/dev/null || true
say "done"
